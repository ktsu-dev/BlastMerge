<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.Tool" />

  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BlastMerge.Cli/BlastMerge.Cli.csproj" />
  </ItemGroup>

  <!-- BlastMerge.Cli is an executable in its own right, so referencing it drags its apphost
       into the tools/ payload alongside the assembly we actually want. Nothing can reach it - the
       command runs ktsu.BlastMerge.Tool.dll through the shared dotnet host - and it is native to
       whichever OS packed the release, which a RID-agnostic tool package has no business carrying.
       ktsu.Sdk.Tool already drops this project's own apphost; this drops the one that arrives with
       the reference. -->
  <Target Name="_RemoveCliAppHostFromToolPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CliAppHostToDrop Include="@(ResolvedFileToPublish)"
                         Condition="'%(ResolvedFileToPublish.RelativePath)' == 'ktsu.BlastMerge.Cli' Or '%(ResolvedFileToPublish.RelativePath)' == 'ktsu.BlastMerge.Cli.exe'" />
      <ResolvedFileToPublish Remove="@(_CliAppHostToDrop)" />
    </ItemGroup>
  </Target>
</Project>
